    "order": 1,
    "width": 12,
    "height": 2,
    "name": "Status do Pet",
    "label": "",
    "format": "{{msg.payload}}",
    "layout": "col-center",
    "x": 800,
    "y": 240,
    "wires": []
  },
  {
    "id": "text_pet_info",
    "type": "ui_text",
    "z": "tab_petflow",
    "group": "group_info",
    "order": 1,
    "width": 12,
    "height": 1,
    "name": "Info Pet",
    "label": "",
    "format": "{{msg.payload}}",
    "layout": "col-center",
    "x": 800,
    "y": 260,
    "wires": []
  },
  {
    "id": "ui_chart",
    "type": "ui_chart",
    "z": "tab_petflow",
    "name": "Histórico Temperatura",
    "group": "group_chart",
    "order": 1,
    "width": 12,
    "height": 6,
    "label": "Histórico de Temperatura (°C)",
    "chartType": "line",
