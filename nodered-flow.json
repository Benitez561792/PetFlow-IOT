[
  {
    "id": "tab_petflow",
    "type": "tab",
    "label": "PetFlow — Monitor de Temperatura",
    "disabled": false,
    "info": "Dashboard de monitoramento de temperatura do pet via MQTT"
  },
  {
    "id": "mqtt_in_temp",
    "type": "mqtt in",
    "z": "tab_petflow",
    "name": "Recebe Temperatura",
    "topic": "petflow/temperatura",
    "qos": "1",
    "datatype": "json",
    "broker": "broker_hivemq",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 120,
    "y": 100,
    "wires": [
      [
        "split_data"
      ]
    ]
  },
  {
    "id": "split_data",
    "type": "function",
    "z": "tab_petflow",
    "name": "Salva Dados Completos",
    "func": "msg.data = msg.payload;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 340,
    "y": 100,
    "wires": [
      [
        "extract_temp",
        "extract_humidity",
        "check_status",
        "text_pet",
        "chart_temp"
      ]
    ]
  },
  {
    "id": "extract_temp",
    "type": "function",
    "z": "tab_petflow",
    "name": "Extrai Temperatura",
    "func": "msg.payload = msg.data.temperatura;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 580,
    "y": 40,
    "wires": [
      [
        "gauge_temp"
      ]
    ]
  },
  {
    "id": "extract_humidity",
    "type": "function",
    "z": "tab_petflow",
    "name": "Extrai Umidade",
    "func": "msg.payload = msg.data.umidade;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 580,
    "y": 100,
    "wires": [
      [
        "gauge_humidity"
      ]
    ]
  },
  {
    "id": "check_status",
    "type": "function",
    "z": "tab_petflow",
    "name": "Verifica Status",
    "func": "var d    = msg.data;\nvar temp = d.temperatura;\nvar st   = d.status;\nvar pet  = d.pet || 'Pet';\n\n// Faixas normais por espécie (para mensagem contextualizada)\nvar faixas = {\n  'Hamster'  : '37–38°C',\n  'Coelho'   : '38–39.5°C',\n  'Gato'     : '37.5–39.2°C',\n  'Cachorro' : '37.5–39.2°C',\n  'Porquinho': '38–40°C',\n  'Ferret'   : '37.8–40°C',\n  'Chinchila': '36–38°C'\n};\nvar faixa = faixas[pet] ? ' (normal: ' + faixas[pet] + ')' : '';\n\nvar texts = {\n  'NORMAL'    : '✅ ' + pet + ' está bem! Temperatura normal: ' + temp + '°C' + faixa,\n  'FEBRE'     : '🌡️ ATENÇÃO! ' + pet + ' com febre: ' + temp + '°C' + faixa + ' — Consulte o veterinário!',\n  'CRITICO'   : '🚨 CRÍTICO! ' + pet + ': ' + temp + '°C' + faixa + ' — EMERGÊNCIA VETERINÁRIA!',\n  'HIPOTERMIA': '🥶 ATENÇÃO! ' + pet + ' com hipotermia: ' + temp + '°C' + faixa + ' — Consulte o veterinário!'\n};\n\nmsg.payload   = texts[st] || ('Status desconhecido: ' + st);\nmsg.status    = st;\nmsg.alertFlag = (st !== 'NORMAL');\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 580,
    "y": 180,
    "wires": [
      [
        "text_status",
        "notification_filter"
      ]
    ]
  },
  {
    "id": "text_pet",
    "type": "function",
    "z": "tab_petflow",
    "name": "Info do Pet",
    "func": "var d = msg.data;\nvar faixas = {\n  'Hamster'  : '37–38°C',\n  'Coelho'   : '38–39.5°C',\n  'Gato'     : '37.5–39.2°C',\n  'Cachorro' : '37.5–39.2°C',\n  'Porquinho': '38–40°C',\n  'Ferret'   : '37.8–40°C',\n  'Chinchila': '36–38°C'\n};\nvar faixa = faixas[d.pet] ? ' | Faixa normal: ' + faixas[d.pet] : '';\nmsg.payload = '🐾 ' + (d.pet || 'Pet')\n  + ' | Leitura #' + d.leitura\n  + ' | Dispositivo: ' + d.device\n  + faixa\n  + ' | ' + d.timestamp;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 580,
    "y": 260,
    "wires": [
      [
        "text_pet_info"
      ]
    ]
  },
  {
    "id": "notification_filter",
    "type": "function",
    "z": "tab_petflow",
    "name": "Filtra Alerta",
    "func": "if (msg.alertFlag) {\n  msg.topic = 'PetFlow Alerta';\n  return msg;\n}\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "x": 800,
    "y": 180,
    "wires": [
      [
        "ui_notification"
      ]
    ]
  },
  {
    "id": "chart_temp",
    "type": "function",
    "z": "tab_petflow",
    "name": "Prepara Gráfico",
    "func": "msg.topic   = 'Temperatura';\nmsg.payload = msg.data.temperatura;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 580,
    "y": 340,
    "wires": [
      [
        "ui_chart"
      ]
    ]
  },
  {
    "id": "gauge_temp",
    "type": "ui_gauge",
    "z": "tab_petflow",
    "name": "Temperatura",
    "group": "group_main",
    "order": 1,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "Temperatura do Pet (°C)",
    "label": "°C",
    "format": "{{value}}",
    "min": 35,
    "max": 42,
    "colors": [
      "#3498db",
      "#27ae60",
      "#e67e22",
      "#e74c3c"
    ],
    "seg1": "37.5",
    "seg2": "39.2",
    "x": 800,
    "y": 40,
    "wires": []
  },
  {
    "id": "gauge_humidity",
    "type": "ui_gauge",
    "z": "tab_petflow",
    "name": "Umidade",
    "group": "group_main",
    "order": 2,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "Umidade Relativa (%)",
    "label": "%",
    "format": "{{value}}",
    "min": 0,
    "max": 100,
    "colors": [
      "#e74c3c",
      "#27ae60",
      "#3498db"
    ],
    "seg1": "30",
    "seg2": "70",
    "x": 800,
    "y": 100,
    "wires": []
  },
  {
    "id": "text_status",
    "type": "ui_text",
    "z": "tab_petflow",
